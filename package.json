{
  "name": "earshot",
  "version": "0.3.0",
  "description": "Framework-agnostic in-browser audio engine: capture, DSP features, local audio models, anomaly profiles and vocalization events.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezar/earshot.git"
  },
  "sideEffects": false,
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker/engine-worker.ts",
    "./capture-worklet": "./src/capture/capture-worklet.ts",
    "./clap": "./src/models/clap.ts",
    "./mlp": "./src/classify/mlp.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "playground": "vite --config playground/vite.config.ts",
    "eval:fetch": "node scripts/eval/fetch-datasets.mjs",
    "eval:run": "node scripts/eval/run-eval.mjs"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3",
    "@mediapipe/tasks-audio": ">=0.10",
    "@tensorflow/tfjs": ">=4"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": { "optional": true },
    "@mediapipe/tasks-audio": { "optional": true },
    "@tensorflow/tfjs": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.33.0",
  "keywords": ["audio", "yamnet", "mediapipe", "anomaly-detection", "browser", "dsp"]
}
